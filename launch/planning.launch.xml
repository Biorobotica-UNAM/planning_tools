<launch>
    <!-- 1. Declarar el argumento que esperamos recibir -->
    <arg name="plan_name" default="default_plan"/>
    <arg name="use_semantic_compare" default="false"/>
    <arg name="semantic_return_backend" default="best"/>
    <arg name="qwen_url" default="http://127.0.0.1:8008"/>
    <arg name="qwen_api_key" default=""/>
    <arg name="qwen_timeout_sec" default="15.0"/>
    
    <group>
        <push_ros_namespace namespace="planning"/>

        <!-- 2. Incluir el launch de CLIPS y pasarle el argumento -->
        <include file="$(find-pkg-share clips_launch)/launch/clips.launch.xml">
            <!-- Esta es la línea clave: propaga el argumento hacia abajo -->
            <arg name="plan_name" value="$(var plan_name)"/>
        </include>

        <!-- Semantic parser -->
        <include file="$(find-pkg-share semantic_parser)/launch/semantic_parser.launch.xml">
            <arg name="use_semantic_compare" value="$(var use_semantic_compare)"/>
            <arg name="semantic_return_backend" value="$(var semantic_return_backend)"/>
            <arg name="qwen_url" value="$(var qwen_url)"/>
            <arg name="qwen_api_key" value="$(var qwen_api_key)"/>
            <arg name="qwen_timeout_sec" value="$(var qwen_timeout_sec)"/>
        </include>

    </group>
</launch>
